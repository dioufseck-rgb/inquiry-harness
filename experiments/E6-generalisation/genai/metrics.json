  "accepted_main_claims": [
    {
      "id": "C5",
      "text": "\u201cNo measurable return\u201d conflates unmeasured benefits, absent financial impact, and negative returns; these interpretations yield different answers about enterprise generative-AI pilots.",
      "target": {},
      "scope": true
    }
  ],
  "accepted_components": [
    {
      "id": "C10",
      "text": "The originating research studied a selected set of enterprise AI initiatives using interviews, surveys, and public cases, rather than a probability sample of enterprise generative-AI pilots.",
      "issue_id": "Q3"
    },
    {
      "id": "C11",
      "text": "The originating research assessed enterprise generative-AI returns through reported organizational outcomes, rather than audited financial returns for every sampled pilot.",
      "issue_id": "Q3"
    },
    {
      "id": "C18",
      "text": "Other studies report organization-level, production-use, or broader AI outcomes rather than comparable enterprise generative-AI pilot return rates.",
      "issue_id": "Q4"
    },
    {
      "id": "C19",
      "text": "NANDA reports zero return for 95% of organizations; separately, it says 5% of integrated AI pilots extract millions and the vast majority have no measurable P&L impact.",
      "issue_id": "Q1"
    },
    {
      "id": "C20",
      "text": "NANDA reports that 60% of organizations evaluated enterprise-grade tools, 20% reached pilots and 5% reached production; these are adoption-stage shares, not pilot return rates.",
      "issue_id": "Q1"
    },
    {
      "id": "C21",
      "text": "The complement of the reported 5% of integrated pilots extracting millions is 95% not meeting that threshold, not 95% demonstrated to lack any measurable benefit.",
      "issue_id": "Q1"
    },
    {
      "id": "C23",
      "text": "The report states that ROI impact was measured six months post-pilot and adjusted for department size; the supplied methodology passages do not identify the pilot denominator or calculation behind the headline proportion.",
      "issue_id": "Q3"
    }
  ],
