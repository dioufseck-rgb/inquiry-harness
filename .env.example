ANTHROPIC_API_KEY=
OPENAI_API_KEY=
SERPER_API_KEY=
# Bare names still select Anthropic. For OpenAI, list your accessible models
# with client.models.list(), then replace these placeholders with two distinct
# text models (critic: larger model or higher effort).
# INQUIRY_PROPOSER_MODEL=openai:<proposer-model-from-models-list>
# INQUIRY_CRITIC_MODEL=openai:<critic-model-from-models-list>
INQUIRY_PROPOSER_MODEL=anthropic:claude-sonnet-5-5
INQUIRY_CRITIC_MODEL=anthropic:claude-opus-5-5
# OpenAI effort: low | medium | high (default medium for either role)
INQUIRY_PROPOSER_EFFORT=medium
INQUIRY_CRITIC_EFFORT=high
# Checked at round boundaries; Conclude still runs on existing evidence.
INQUIRY_MAX_TOKENS_RUN=0
